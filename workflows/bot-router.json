    },
    {
      "parameters": {
        "jsCode": "const event = $json;\nconst chatId = event.message?.chat?.id ?? event.callback_query?.message?.chat?.id;\nif (chatId === undefined || String(chatId) !== String($env.ALLOWED_CHAT_ID || '')) return [];\nconst text = event.message?.text || '';\nlet route = '';\nlet id = '';\nif (/^\\/(?:start|next)(?:@\\w+)?(?:\\s.*)?$/i.test(text)) route = 'next';\nelse {\n  const add = text.match(/^\\/add(?:@\\w+)?\\s+(\\S+)\\s*$/i);\n  if (add) { route = 'add'; event.vacancy_url = add[1]; }\n}\nif (!route && event.callback_query) {\n  const data = event.callback_query.data || '';\n  if (data === 'stop') route = 'stop';\n  else {\n    const action = data.match(/^(apply|skip):([a-f0-9]{12})$/i);\n    if (action) { route = action[1].toLowerCase(); id = action[2].toLowerCase(); }\n  }\n}\nif (!route) return [];\nreturn [{ json: { ...event, route, id } }];"
      },
      "id": "ff2558ae-97dc-4fb9-9097-b46d8bb7e248",
