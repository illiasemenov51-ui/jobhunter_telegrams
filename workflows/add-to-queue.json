  "name": "add-to-queue",
  "nodes": [
    {
      "parameters": {},
      "id": "b390bd24-0e91-46ec-99f9-5b271b64db71",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
