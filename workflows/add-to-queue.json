    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = String($json.vacancy_url || '').trim();\nlet url;\ntry { url = new URL(raw); } catch { return { json: { valid: false, error: 'Please use a valid https URL.' } }; }\nconst host = url.hostname.toLowerCase();\nconst net = require('net');\nif (url.protocol !== 'https:' || url.username || url.password || net.isIP(host) || !host.includes('.') || /(^|\\.)(localhost|local|internal|test|invalid)$/.test(host)) {\n  return { json: { valid: false, error: 'Only public https vacancy URLs are accepted.' } };\n}\nconst crypto = require('crypto');\nconst normalizedUrl = url.href;\nconst id = crypto.createHash('sha256').update(normalizedUrl).digest('hex').slice(0, 12);\nlet source = 'manual';\nif (host === 'nofluffjobs.com' || host.endsWith('.nofluffjobs.com')) source = 'nofluffjobs';\nelse if (host === 'justjoin.it' || host.endsWith('.justjoin.it')) source = 'justjoinit';\nelse if (host === 'pracuj.pl' || host.endsWith('.pracuj.pl')) source = 'pracuj';\nelse if (host === 'olx.pl' || host.endsWith('.olx.pl')) source = 'olx';\nreturn { json: { valid: true, id, url: normalizedUrl, status: 'new', source, title: '', company: '', location: '', added_at: new Date().toISOString(), decided_at: '', draft_link: '', notes: '' } };"
      },
      "id": "8016a69e-c33d-41c9-a0af-bfa285ad8338",
      "name": "Validate URL and hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
