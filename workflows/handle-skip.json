{
  "id": "6f1d7104-cfd9-4c91-8c7d-fb8956a81374",
  "name": "handle-skip",
  "nodes": [
    {
      "parameters": {},
      "id": "dc3ca667-95ee-4335-87ea-62686a345117",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {"__rl": true, "mode": "id", "value": "={{ $env.SHEET_ID }}"},
        "sheetName": {"__rl": true, "mode": "name", "value": "queue"},
        "filtersUI": {
          "values": [{"lookupColumn": "id", "lookupValue": "={{ $json.id }}"}]
        },
        "options": {}
      },
      "id": "096bdb41-a3c1-466b-8b5a-a34bc48720e4",
      "name": "Find vacancy by id",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [240, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{ $json.id === $('When Called').first().json.id && $json.status === 'shown' }}",
              "rightValue": "",
              "operator": {"type": "boolean", "operation": "true", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1fc559bf-16b4-4077-843a-0cde6100fda3",
      "name": "Is current vacancy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {"__rl": true, "mode": "id", "value": "={{ $env.SHEET_ID }}"},
        "sheetName": {"__rl": true, "mode": "name", "value": "queue"},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('When Called').first().json.id }}",
            "status": "skipped",
            "decided_at": "={{ new Date().toISOString() }}"
          },
          "matchingColumns": ["id"],
          "schema": [
            {"id": "id", "displayName": "id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true},
            {"id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true},
            {"id": "decided_at", "displayName": "decided_at", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true}
          ]
        },
        "options": {}
      },
      "id": "270f2e65-7e3e-4ddc-9bd6-b5487ae32da0",
      "name": "Mark vacancy skipped",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [720, -80]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {"__rl": true, "value": "b3ea4645-2d21-48f2-a6af-1bc56de5f2e7", "mode": "id"},
        "mode": "once",
        "options": {"waitForSubWorkflow": true}
      },
      "id": "5180fcca-f0ce-4a79-96d2-ce504497d0bb",
      "name": "Send next card",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [960, -80]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('When Called').first().json.callback_query.message.chat.id }}",
        "text": "This vacancy is no longer available for a decision. No queue status was changed.",
        "additionalFields": {"appendAttribution": false}
      },
      "id": "c0f80fd0-c186-446c-896d-fd60a01b5035",
      "name": "Explain stale action",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 120]
    }
  ],
  "connections": {
    "When Called": {"main": [[{"node": "Find vacancy by id", "type": "main", "index": 0}]]},
    "Find vacancy by id": {"main": [[{"node": "Is current vacancy", "type": "main", "index": 0}]]},
    "Is current vacancy": {
      "main": [
        [{"node": "Mark vacancy skipped", "type": "main", "index": 0}],
        [{"node": "Explain stale action", "type": "main", "index": 0}]
      ]
    },
    "Mark vacancy skipped": {"main": [[{"node": "Send next card", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"}
}
