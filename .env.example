# scripts/start.sh sets WEBHOOK_URL to the temporary Cloudflare Quick Tunnel URL.
WEBHOOK_URL=https://localhost/

# scripts/start.sh generates and persists this key on first run.
N8N_ENCRYPTION_KEY=

# Configure the Telegram credential in the n8n UI with this bot token.
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=

# Configure Anthropic and Google Sheets/Drive/Gmail credentials in the n8n UI.
LLM_MODEL=claude-3-5-sonnet-latest
CV_SOURCE=file
SHEET_ID=
GOOGLE_DRIVE_CV_FILE_ID=
