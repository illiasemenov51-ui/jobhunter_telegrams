# The Telegram poller uses the private Docker network; no public webhook URL is needed.
WEBHOOK_URL=http://localhost:5678/

# scripts/start.sh generates and persists this key on first run.
N8N_ENCRYPTION_KEY=

# Configure the Telegram credential in the n8n UI with this bot token.
TELEGRAM_BOT_TOKEN=
# scripts/start.sh generates this internal poller-to-n8n secret on first run.
TELEGRAM_FORWARD_SECRET=
ALLOWED_CHAT_ID=
BOT_DEFAULT_LANGUAGE=pl
JOB_LOCATION=Warszawa
JOB_LOCATION=Warszawa, Poland

# Configure Anthropic and Google Sheets/Drive/Gmail credentials in the n8n UI.
LLM_MODEL=claude-sonnet-5-5
CV_SOURCE=file
SHEET_ID=
GOOGLE_DRIVE_CV_FILE_ID=
